# Database (Aiven MySQL)
DB_URL=jdbc:mysql://your-host:3306/your-db
DB_USER=
DB_PASSWORD=

# JWT signing secret. Generate with:  openssl rand -base64 64
# Required at startup (no default outside test profile).
JWT_SECRET=
JWT_TTL_MINUTES=1440

# Comma-separated list of allowed CORS origins for the frontend.
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Optional one-time admin bootstrap. If both are set AND no ADMIN-role student
# exists, an admin row is seeded on startup with the password BCrypt-hashed.
# After the admin exists, these env vars are ignored on subsequent starts.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
