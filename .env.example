# Database Configuration
DB_URL=jdbc:mysql://your-mysql-host:port/your-database?ssl-mode=REQUIRED
DB_USER=your-db-username
DB_PASSWORD=your-db-password

# JWT Configuration
JWT_SECRET=your-256-bit-jwt-secret-here
JWT_TTL_MINUTES=1440

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin

# Azure Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account-name;AccountKey=your-account-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=recruiter-documents

# Email (Gmail SMTP) - three separate sender identities, one per module
MAIL_JOBHUB_USERNAME=your-jobhub-gmail-address@gmail.com
MAIL_JOBHUB_APP_PASSWORD=your-16-char-google-app-password
MAIL_JOBHUB_FROM_NAME=UniVerse JobHub

MAIL_MARKETPLACE_USERNAME=your-marketplace-gmail-address@gmail.com
MAIL_MARKETPLACE_APP_PASSWORD=your-16-char-google-app-password
MAIL_MARKETPLACE_FROM_NAME=UniVerse Marketplace

MAIL_STUDENT_USERNAME=your-student-gmail-address@gmail.com
MAIL_STUDENT_APP_PASSWORD=your-16-char-google-app-password
MAIL_STUDENT_FROM_NAME=UniVerse

# Gemini (Google AI) - CV skill extraction. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite